# ============================================================
# Docker Compose 环境变量配置
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env
#   2. 修改以下配置项
#   3. 运行 docker-compose up -d --build
# ============================================================

# ============================================================
# 基础配置
# ============================================================
# 运行环境：dev / staging / prod
ENV=prod

# 应用密钥（生产环境必须修改为随机字符串）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-random-secret-key

# ============================================================
# 端口配置
# ============================================================
# MySQL端口（宿主机映射端口，避免与本地MySQL冲突可改为3307）
MYSQL_PORT=3306

# 后端端口（宿主机映射端口）
BACKEND_PORT=8000

# 前端端口（宿主机映射端口，80需要root权限，可改为8080）
FRONTEND_PORT=80

# ============================================================
# MySQL 数据库配置
# ============================================================
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=travel
MYSQL_USER=travel
MYSQL_PASSWORD=your_strong_db_password

# ============================================================
# CORS 配置（允许访问后端的前端域名，多个用逗号分隔）
# ============================================================
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com

# ============================================================
# AI 模型配置
# ============================================================
# AI提供商：openai（兼容OpenAI API的服务，如DeepSeek）
AI_PROVIDER=openai

# OpenAI兼容API的Base URL（DeepSeek: https://api.deepseek.com/v1）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# API密钥
OPENAI_API_KEY=your_deepseek_api_key

# 模型名称
AI_MODEL=deepseek-chat

# ============================================================
# 地图服务配置
# ============================================================
# 地图提供商：tencent / amap
MAP_PROVIDER=tencent

# 腾讯地图Web服务Key
TENCENT_MAP_KEY=your_tencent_map_key

# 高德地图Web服务Key（可选，作为备用）
AMAP_KEY=your_amap_web_service_key

# ============================================================
# 前端构建配置（构建时注入）
# ============================================================
# 前端API基础路径（使用Nginx反向代理时为/api）
VITE_API_BASE_URL=/api

# 高德地图Web端JS API Key（前端地图展示用）
VITE_AMAP_WEB_KEY=your_amap_web_js_key

# ============================================================
# 邮箱服务配置（可选，用于注册验证码）
# ============================================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_email_auth_code

# ============================================================
# 日志配置
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# RAG 知识库配置（可选）
# ============================================================
# 是否启用 RAG 知识库功能（需要构建时包含 RAG 依赖）
# 注意：启用 RAG 需要使用 --build-arg INCLUDE_RAG=true 构建镜像
RAG_ENABLED=false

# RAG 数据目录（容器内路径，通过数据卷持久化）
RAG_DATA_DIR=/app/data/knowledge_base

# RAG 向量化模型名称（中文优化的小模型）
RAG_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 构建时是否包含 RAG 依赖（true/false）
# 注意：包含 RAG 会增加镜像体积约 2GB（torch + sentence-transformers）
INCLUDE_RAG=false

# ============================================================
# 数据持久化目录（宿主机路径）
# ============================================================
# MySQL 数据目录
MYSQL_DATA_DIR=./data/mysql

# 日志数据目录
LOG_DATA_DIR=./data/logs

# RAG 数据目录
RAG_DATA_HOST_DIR=./data/rag

# ============================================================
# 服务启动配置
# ============================================================
# 等待 MySQL 最大重试次数
MAX_RETRIES=30

# 等待 MySQL 重试间隔（秒）
RETRY_DELAY=2

# ============================================================
# 腾讯地图签名密钥（可选，腾讯地图 WebService API 需要）
# ============================================================
TENCENT_MAP_SK=your_tencent_map_sk
