# ============================================================
# AI 旅行行程规划应用 - 环境配置示例
# ============================================================
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 根据实际情况修改配置值
# 3. 敏感配置（密钥、密码等）必须配置，不使用硬编码默认值
#
# 配置优先级：.env.{ENV} > .env > 环境变量 > 代码默认值
# 运行环境通过 ENV 环境变量指定：dev / staging / prod，默认 dev
# ============================================================

# ===== 运行环境 =====
# 运行环境：dev / staging / prod，默认 dev
ENV=dev
# 调试模式：true / false，开发环境默认 true，生产环境默认 false
DEBUG=true
# 日志级别：DEBUG / INFO / WARNING / ERROR，开发环境默认 DEBUG，生产环境默认 INFO
LOG_LEVEL=DEBUG
# 日志格式：text / json，开发环境默认 text，生产环境默认 json
LOG_FORMAT=text

# ===== CORS 允许来源 =====
# 逗号分隔，* 表示全部，开发环境默认允许 localhost:5173
CORS_ORIGINS=*

# ===== 高德地图 Web 服务 API Key（必配才能用真实数据）=====
# 申请地址：https://console.amap.com/dev/key/app
# 注意：前端使用 Web 端 JS API Key，后端使用 Web 服务 API Key，两者不同
# 不配置则地图相关功能不可用（无 mock 数据）
AMAP_KEY=

# ===== 腾讯地图 WebService API Key（高德不可用时的兼容 Provider，可选）=====
# 申请地址：https://lbs.qq.com/ 控制台 -> 我的应用 -> 创建应用并启用 WebService API
# 高德优先、腾讯兜底：高德额度耗尽或 Key 失效时自动切换腾讯真实数据
TENCENT_KEY=
# 腾讯地图签名密钥 sk（WebService API 强制签名鉴权，key+sk 缺一不可）
# 在腾讯位置服务控制台 -> 我的应用 -> 应用详情中查看「密钥」(sk)
TENCENT_SK=

# ===== 本地轻量 AI 模型（通过 Ollama 运行）=====
# Ollama 下载：https://ollama.com/download
# 拉取模型示例：ollama pull qwen2:7b（推荐）或 qwen2.5:3b（更省内存）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2:7b

# ===== MySQL（生产数据库，必配）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=travel
# 数据库密码（敏感配置，必须配置，无默认值）
DB_PASSWORD=
DB_NAME=travel_app

# ===== 数据库连接池配置（可选，有默认值）=====
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CACHED=2
DB_POOL_MAX_CACHED=5
DB_POOL_MAX_SHARED=5
DB_POOL_BLOCKING=true
DB_POOL_MAX_USAGE=0
# 数据库超时配置（秒）
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# ===== JWT（无状态会话，必配）=====
# JWT 密钥（敏感配置，必须配置，无默认值）
# 生产环境务必改成随机长密钥：openssl rand -hex 32
JWT_SECRET=
# JWT 算法：HS256 / RS256 等，默认 HS256
JWT_ALGORITHM=HS256
# Token 过期时间（小时），默认 24
TOKEN_EXPIRE_HOURS=24

# ===== Redis（分布式缓存，可选；未配置时使用内存缓存）=====
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_KEY_PREFIX=travel:

# ===== 日志目录（可选）=====
# 日志文件存放目录，默认使用系统目录：
# - macOS: ~/Library/Logs/travel-app/
# - Linux: ~/.cache/travel-app/
# - Windows: %LOCALAPPDATA%/travel-app/
# LOG_DIR=

# ===== RAG 知识库配置（可选）=====
# 是否启用 RAG 知识库功能，默认 false
RAG_ENABLED=true
# 提示词配置文件路径
PROMPT_CONFIG_PATH=config/prompts.json
